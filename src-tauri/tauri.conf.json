{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CP Companion",
  "version": "0.1.0",
  "identifier": "com.cpcompanion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CP Companion",
        "width": 360,
        "height": 700,
        "minWidth": 300,
        "minHeight": 480,
        "maxWidth": 560,
        "maxHeight": 1000,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "shadow": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MjVEQzlDRDAwQjBBQUQKUldTdENndlFuTndsK1ZGYkk0ZER1QUJVa0s3WUFEVUQ0Y0d0YnRVWC9BWkFicHZuMTJQczQvU2UK",
      "endpoints": [
        "https://github.com/priyanshu-18/cp-companion/releases/latest/download/latest.json"
      ]
    }
  }
}